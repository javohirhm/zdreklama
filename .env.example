# Platform DeepSeek key for the AI agent.
# The key is read only from the server environment; users never enter it in the app.

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Full chat-completions endpoint, or a base URL for an OpenAI-compatible proxy.
# DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions

# Snapshot size limits. Complete financial totals are always calculated from the full database.
# AGENT_TRANSACTION_LIMIT=500
# AGENT_MOVEMENT_LIMIT=500
