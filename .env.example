# Optional: DeepSeek AI agent.
# You can also connect and replace the key from the in-app agent panel.
# A key saved in the panel (server/data/agent.json) takes precedence over this file.

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Full chat-completions endpoint, or a base URL for an OpenAI-compatible proxy.
# DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions

# Snapshot size limits. Complete financial totals are always calculated from the full database.
# AGENT_TRANSACTION_LIMIT=500
# AGENT_MOVEMENT_LIMIT=500
